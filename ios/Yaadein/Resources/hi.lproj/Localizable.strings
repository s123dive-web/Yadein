"privacy_s1_body" = "कुछ नहीं। Yaadein के पास इंटरनेट अनुमति, खाता या एनालिटिक्स नहीं है। यह आपका डेटा कहीं भेज ही नहीं सकता।";
"privacy_s1_title" = "Yaadein क्या इकट्ठा करता है";
"privacy_s2_body" = "आपके लोग, यादें, फ़ोटो, वीडियो, आवाज़ की रिकॉर्डिंग, नोट और सेटिंग ऐप की निजी जगह में एन्क्रिप्ट होकर रहते हैं। Yaadein PIN के साथ चाबियाँ सिर्फ़ आपके PIN या फ़िंगरप्रिंट से खुलती हैं। इस ऐप के लिए Android क्लाउड बैकअप बंद है।";
"privacy_s2_title" = "आपके फ़ोन पर क्या रहता है";
"privacy_s3_body" = "चेहरे के सुझाव (शुरू में बंद) फ़ोन पर ही, साथ दिए मॉडल से चेहरे खोजते और मिलाते हैं; चेहरों के माप सिर्फ़ आपकी एन्क्रिप्टेड तिजोरी में रहते हैं और सेटिंग्स → चेहरा सुझाव में मिटाए जा सकते हैं। स्मार्ट पॉलिश सिर्फ़ उन्हीं फ़ोन पर Gemini Nano इस्तेमाल करता है जिनमें वह पहले से है। आवाज़ वाली यादें माइक्रोफ़ोन सिर्फ़ रिकॉर्ड करते समय इस्तेमाल करती हैं। रिमाइंडर और विजेट फ़ोन पर तय होते हैं और लॉक स्क्रीन पर छिपे रहते हैं।";
"privacy_s3_title" = "वैकल्पिक फ़ोन-पर सुविधाएँ";
"privacy_s4_body" = "सिर्फ़ तब, जब आप चाहें: रील, किसी याद की तस्वीर या PDF, पासवर्ड वाला फ़ैमिली पैक, या पासवर्ड वाला बैकअप (हाथ से या हर हफ़्ते आपकी चुनी फ़ाइल में) भेजते समय।";
"privacy_s4_title" = "डेटा फ़ोन से कब बाहर जाता है";
"privacy_s5_body" = "ऐप अनइंस्टॉल करें, या सेटिंग्स → स्टोरेज → सब कुछ मिटाएँ। और कुछ हटाने को नहीं है।";
"privacy_s5_title" = "डेटा हटाना";
"privacy_s6_body" = "Yaadein सब उम्र के लिए है: न विज्ञापन, न ट्रैकिंग, न इन-ऐप खरीद।";
"privacy_s6_title" = "बच्चे और परिवार";
