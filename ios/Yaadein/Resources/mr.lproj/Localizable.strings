"privacy_s1_body" = "काहीही नाही. Yaadein ला इंटरनेट परवानगी, खाती किंवा अ‍ॅनालिटिक्स नाहीत. ते तुमचा डेटा कुठेही पाठवूच शकत नाही.";
"privacy_s1_title" = "Yaadein काय गोळा करतं";
"privacy_s2_body" = "तुमची माणसे, आठवणी, फोटो, व्हिडिओ, आवाजातील रेकॉर्डिंग, नोंदी आणि सेटिंग्ज ॲपच्या खाजगी जागेत एन्क्रिप्ट होऊन राहतात. Yaadein PIN सह चाव्या फक्त तुमच्या PIN किंवा फिंगरप्रिंटने उघडतात. या ॲपसाठी Android क्लाउड बॅकअप बंद आहे.";
"privacy_s2_title" = "तुमच्या फोनवर काय राहतं";
"privacy_s3_body" = "चेहऱ्यांच्या सूचना (सुरुवातीला बंद) फोनवरच, सोबतच्या मॉडेलने चेहरे शोधतात आणि जुळवतात; चेहऱ्यांची मोजमापं फक्त तुमच्या एन्क्रिप्टेड तिजोरीत राहतात आणि सेटिंग्ज → चेहरा सूचना इथून हटवता येतात. स्मार्ट पॉलिश फक्त ज्या फोनमध्ये Gemini Nano आधीच आहे तिथेच तो वापरते. आवाजातील आठवणी मायक्रोफोन फक्त रेकॉर्ड करताना वापरतात. रिमाइंडर आणि विजेट फोनवर ठरतात आणि लॉक स्क्रीनवर लपलेले राहतात.";
"privacy_s3_title" = "ऐच्छिक फोनवरील सुविधा";
"privacy_s4_body" = "फक्त तुम्ही ठरवाल तेव्हा: रील, आठवणीचे चित्र किंवा PDF, पासवर्ड असलेला फॅमिली पॅक, किंवा पासवर्ड असलेला बॅकअप (हाताने किंवा दर आठवड्याला तुम्ही निवडलेल्या फाइलमध्ये) पाठवताना.";
"privacy_s4_title" = "डेटा फोनबाहेर कधी जातो";
"privacy_s5_body" = "अ‍ॅप अनइन्स्टॉल करा, किंवा सेटिंग्ज → स्टोरेज → सगळं पुसा. दुसरं काही हटवण्यासारखं नाही.";
"privacy_s5_title" = "डेटा हटवणे";
"privacy_s6_body" = "Yaadein सर्व वयांसाठी आहे: जाहिराती नाहीत, ट्रॅकिंग नाही, इन-अ‍ॅप खरेदी नाही.";
"privacy_s6_title" = "मुले आणि कुटुंबे";
"privacy_title" = "गोपनीयता";
