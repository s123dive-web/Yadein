"privacy_s1_body" = "Nothing. Yaadein has no internet permission, no accounts and no analytics. It cannot send your data anywhere.";
"privacy_s1_title" = "What Yaadein collects";
"privacy_s2_body" = "Your people, memories, photos, videos, voice recordings, notes and settings stay in the app's private storage, encrypted. With a Yaadein PIN, the keys can only be unlocked with your PIN or fingerprint. Android cloud backup is switched off for this app.";
"privacy_s2_title" = "What stays on your phone";
"privacy_s3_body" = "Face suggestions (off by default) find and compare faces on the phone with a bundled model; the face measurements are stored only in your encrypted vault and can be deleted in Settings → Face suggestions. Smart polish uses Gemini Nano on the phone only where it is already installed. Voice memories use the microphone only while you record. Reminders and the widget are scheduled on the phone and hidden on the lock screen.";
"privacy_s3_title" = "Optional on-device features";
"privacy_s4_body" = "Only when you choose to: sharing a reel, a picture or PDF of a memory, a password-protected family pack, or a password-protected backup (by hand, or weekly to a file you picked).";
"privacy_s4_title" = "When data leaves the phone";
"privacy_s5_body" = "Uninstall the app, or use Settings → Storage → Erase everything. There is nothing else to delete.";
"privacy_s5_title" = "Deleting your data";
"privacy_s6_body" = "Yaadein is for all ages: no ads, no tracking, no in-app purchases.";
"privacy_s6_title" = "Children and families";
"privacy_title" = "Privacy";
