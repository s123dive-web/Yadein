"privacy_s5_body" = "ஆப்பை நிறுவல் நீக்குங்கள், அல்லது அமைப்புகள் → சேமிப்பகம் → அனைத்தையும் அழி என்பதைப் பயன்படுத்துங்கள். நீக்க வேறு எதுவும் இல்லை.";
"privacy_s5_title" = "உங்கள் தரவை நீக்குதல்";
"privacy_s6_body" = "Yaadein எல்லா வயதினருக்கும் ஏற்றது: விளம்பரங்கள் இல்லை, கண்காணிப்பு இல்லை, ஆப்பில் வாங்குதல்கள் இல்லை.";
