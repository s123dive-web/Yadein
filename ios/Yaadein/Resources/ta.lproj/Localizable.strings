"privacy_s1_body" = "எதுவும் இல்லை. Yaadein-க்கு இணைய அனுமதி இல்லை, கணக்குகள் இல்லை, பகுப்பாய்வு இல்லை. உங்கள் தரவை அதனால் எங்கும் அனுப்ப முடியாது.";
"privacy_s1_title" = "Yaadein எதைச் சேகரிக்கிறது";
"privacy_s2_body" = "உங்கள் நபர்கள், நினைவுகள், புகைப்படங்கள், வீடியோக்கள், குரல் பதிவுகள், குறிப்புகள், அமைப்புகள் ஆப்பின் தனிப்பட்ட இடத்தில் மறையாக்கப்பட்டு இருக்கும். Yaadein PIN இருந்தால், உங்கள் PIN அல்லது கைரேகையால் மட்டுமே சாவிகளைத் திறக்க முடியும். இந்த ஆப்பிற்கு Android கிளவுட் காப்புப்பிரதி அணைக்கப்பட்டுள்ளது.";
"privacy_s2_title" = "உங்கள் ஃபோனில் இருப்பவை";
"privacy_s3_body" = "முக பரிந்துரைகள் (இயல்பாக அணைப்பு) போனிலேயே, உள்ளிணைந்த மாடலுடன் முகங்களைக் கண்டறிந்து ஒப்பிடும்; முக அளவீடுகள் உங்கள் மறையாக்கப்பட்ட பெட்டகத்தில் மட்டுமே சேமிக்கப்படும், அமைப்புகள் → முகப் பரிந்துரைகள் பக்கத்தில் நீக்கலாம். Smart polish ஏற்கெனவே நிறுவப்பட்ட போன்களில் மட்டும் Gemini Nano-வைப் பயன்படுத்தும். குரல் நினைவுகள் பதிவு செய்யும்போது மட்டுமே மைக்ரோஃபோனைப் பயன்படுத்தும். நினைவூட்டல்களும் விட்ஜெட்டும் போனிலேயே திட்டமிடப்பட்டு, பூட்டுத் திரையில் மறைக்கப்படும்.";
"privacy_s3_title" = "விருப்பமான, ஃபோனிலேயே இயங்கும் வசதிகள்";
"privacy_s4_body" = "நீங்கள் தேர்ந்தெடுக்கும்போது மட்டும்: ரீல், நினைவின் படம் அல்லது PDF, கடவுச்சொல் உள்ள குடும்பத் தொகுப்பு, அல்லது கடவுச்சொல் உள்ள காப்புப்பிரதி (கையால், அல்லது வாரந்தோறும் நீங்கள் தேர்ந்த கோப்பில்) பகிரும்போது.";
