"privacy_s1_body" = "ಏನೂ ಇಲ್ಲ. Yaadein ಗೆ ಇಂಟರ್ನೆಟ್ ಅನುಮತಿ ಇಲ್ಲ, ಖಾತೆಗಳಿಲ್ಲ, ಅನಾಲಿಟಿಕ್ಸ್ ಇಲ್ಲ. ಅದು ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಎಲ್ಲಿಗೂ ಕಳುಹಿಸಲಾರದು.";
"privacy_s1_title" = "Yaadein ಏನು ಸಂಗ್ರಹಿಸುತ್ತದೆ";
"privacy_s2_body" = "ನಿಮ್ಮ ವ್ಯಕ್ತಿಗಳು, ನೆನಪುಗಳು, ಫೋಟೋಗಳು, ವೀಡಿಯೊಗಳು, ಧ್ವನಿ ರೆಕಾರ್ಡಿಂಗ್‌ಗಳು, ಟಿಪ್ಪಣಿಗಳು ಮತ್ತು ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಆ್ಯಪ್‌ನ ಖಾಸಗಿ ಜಾಗದಲ್ಲಿ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಆಗಿರುತ್ತವೆ. Yaadein PIN ಇದ್ದರೆ, ಕೀಲಿಗಳು ನಿಮ್ಮ PIN ಅಥವಾ ಬೆರಳಚ್ಚಿನಿಂದ ಮಾತ್ರ ತೆರೆಯುತ್ತವೆ. ಈ ಆ್ಯಪ್‌ಗೆ Android ಕ್ಲೌಡ್ ಬ್ಯಾಕಪ್ ಆಫ್ ಆಗಿದೆ.";
"privacy_s2_title" = "ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲೇ ಏನು ಉಳಿಯುತ್ತದೆ";
"privacy_s3_body" = "ಮುಖದ ಸಲಹೆಗಳು (ಆರಂಭದಲ್ಲಿ ಆಫ್) ಫೋನ್‌ನಲ್ಲೇ ಓಡುತ್ತವೆ. Smart polish ಈಗಾಗಲೇ ಇರುವ ಫೋನ್‌ಗಳಲ್ಲಿ ಮಾತ್ರ Gemini Nano ಬಳಸುತ್ತದೆ. ಧ್ವನಿ ನೆನಪುಗಳು ರೆಕಾರ್ಡ್ ಮಾಡುವಾಗ ಮಾತ್ರ ಮೈಕ್ರೊಫೋನ್ ಬಳಸುತ್ತವೆ. ರಿಮೈಂಡರ್‌ಗಳು ಮತ್ತು ವಿಜೆಟ್ ಫೋನ್‌ನಲ್ಲೇ ನಿಗದಿಯಾಗುತ್ತವೆ ಮತ್ತು ಲಾಕ್ ಸ್ಕ್ರೀನ್‌ನಲ್ಲಿ ಮರೆಯಾಗಿರುತ್ತವೆ.";
"privacy_s3_title" = "ಐಚ್ಛಿಕ, ಫೋನ್‌ನಲ್ಲೇ ನಡೆಯುವ ಸೌಲಭ್ಯಗಳು";
"privacy_s4_body" = "ನೀವು ಆರಿಸಿದಾಗ ಮಾತ್ರ: ರೀಲ್, ನೆನಪಿನ ಚಿತ್ರ ಅಥವಾ PDF, ಪಾಸ್‌ವರ್ಡ್ ಇರುವ ಕುಟುಂಬ ಪ್ಯಾಕ್, ಅಥವಾ ಪಾಸ್‌ವರ್ಡ್ ಇರುವ ಬ್ಯಾಕಪ್ (ಕೈಯಾರೆ, ಅಥವಾ ಪ್ರತಿ ವಾರ ನೀವು ಆರಿಸಿದ ಫೈಲ್‌ಗೆ) ಕಳುಹಿಸುವಾಗ.";
"privacy_s4_title" = "ಡೇಟಾ ಫೋನ್‌ನಿಂದ ಯಾವಾಗ ಹೊರಗೆ ಹೋಗುತ್ತದೆ";
"privacy_s5_body" = "ಆ್ಯಪ್ ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ, ಅಥವಾ ಸೆಟ್ಟಿಂಗ್‌ಗಳು → ಸಂಗ್ರಹಣೆ → ಎಲ್ಲವನ್ನೂ ಅಳಿಸಿ ಬಳಸಿ. ಅಳಿಸಲು ಬೇರೆ ಏನೂ ಇಲ್ಲ.";
