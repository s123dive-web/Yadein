    <string name="backup_restore_confirm_text">बॅकअपमध्ये %1$d माणसे, %2$d आठवणी आणि %3$d फोटो किंवा व्हिडिओ आहेत. रिस्टोअर आधी या फोनवरील Yaadein मधलं सगळं काढतं.</string>
    <string name="backup_restore_now">रिस्टोअर करा</string>
